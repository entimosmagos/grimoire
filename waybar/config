{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 2,

    "modules-left": [
        "hyprland/workspaces",
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "mpris",
        "backlight",
        "network",
        "pulseaudio",
        "battery",
        "tray",
        "custom/power"
    ],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate"
    },

    "hyprland/window": {
        "max-length": 40
    },

    "clock": {
        "format": "[{:%Y.%m.%d  %I:%M}]",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "[VITAL {capacity}%]",
        "format-charging": "[INFLOW {capacity}%]",
        "format-plugged": "[SOURCE {capacity}%]"
    },

    "network": {
        "format-wifi": "[LINK {essid}]",
        "format-ethernet": "[LINK {ipaddr}]",
        "format-disconnected": "[NO LINK]",
        "tooltip-format": "{ifname}: {ipaddr}"
    },

    "pulseaudio": {
        "format": "[SOUND {volume}%]",
        "format-muted": "[SILENT]",
        "on-click": "pavucontrol"
    },

    "backlight": {
        "format": "[LUMIN {percent}%]"
    },

    "mpris": {
        "format": "[{title}]",
        "format-paused": "[STOP]",
        "max-length": 30
    },

    "tray": {
        "spacing": 6
    },

    "custom/power": {
        "format": "[EXIT]",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/power_menu.xml",
        "menu-actions": {
            "shutdown": "shutdown now",
            "reboot": "reboot",
            "suspend": "systemctl suspend"
        }
    }
}
